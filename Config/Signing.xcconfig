// App identity for Irovi — the only place to change it.
//   IROVI_BUNDLE_ID    bundle ID (must match App Store Connect; permanent after the first upload)
//   DEVELOPMENT_TEAM   10-character Team ID from developer.apple.com → Membership
//   IROVI_APP_STORE_ID numeric Apple ID of the app (App Store Connect → App Information).
//                      Leave empty until the app record exists.
IROVI_BUNDLE_ID = com.irovi.app
DEVELOPMENT_TEAM = 77H4K6A24V
CODE_SIGN_STYLE = Automatic
IROVI_APP_STORE_ID =
//   IROVI_PRIVACY_URL  privacy policy page, opened from Settings → About (same link as App Store Connect).
IROVI_PRIVACY_URL = https:/$()/nguyenhuydiem.netlify.app/policy
