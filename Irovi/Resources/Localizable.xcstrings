    "Irovi does not recommend medicines, supplements or doses. Medicines you add are only used for your own reminders.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi does not recommend medicines, supplements or doses. Medicines you add are only used for your own reminders."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi không gợi ý thuốc, thực phẩm bổ sung hay liều dùng. Thuốc bạn thêm vào chỉ dùng để nhắc chính bạn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi no recomienda medicamentos, suplementos ni dosis. Los medicamentos que añades solo se usan para tus propios recordatorios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Irovi não recomenda remédios, suplementos nem doses. Os remédios que você adiciona são usados apenas para seus próprios lembretes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi ne recommande ni médicaments, ni compléments, ni doses. Les médicaments que vous ajoutez servent uniquement à vos propres rappels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi empfiehlt keine Medikamente, Nahrungsergänzungsmittel oder Dosierungen. Medikamente, die du hinzufügst, werden nur für deine eigenen Erinnerungen genutzt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi は薬、サプリメント、用量を推奨しません。追加した薬は、ご自身のリマインダーにのみ使用されます。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi tidak merekomendasikan obat, suplemen, atau dosis. Obat yang Anda tambahkan hanya digunakan untuk pengingat Anda sendiri."
          }
        }
      }
    },
    "Irovi doesn't interpret results. Ask your doctor what your numbers mean for you.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi doesn't interpret results. Ask your doctor what your numbers mean for you."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi không đánh giá kết quả. Hãy hỏi bác sĩ các con số có ý nghĩa gì với bạn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi no interpreta resultados. Pregunta a tu médico qué significan tus valores en tu caso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Irovi não interpreta resultados. Pergunte ao seu médico o que seus valores significam para você."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi n’interprète pas les résultats. Demandez à votre médecin ce que vos valeurs signifient pour vous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi interpretiert keine Ergebnisse. Frag deinen Arzt, was deine Werte für dich bedeuten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi は結果を解釈しません。数値が何を意味するかは医師に確認してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi tidak menafsirkan hasil. Tanyakan kepada dokter apa arti angka tersebut bagi Anda."
          }
        }
      }
    },
    "Irovi has no account, no servers, no ads, no analytics and no tracking. Nothing you enter is uploaded or shared.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi has no account, no servers, no ads, no analytics and no tracking. Nothing you enter is uploaded or shared."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi không có tài khoản, máy chủ, quảng cáo, công cụ phân tích hay theo dõi. Không có gì bạn nhập được tải lên hay chia sẻ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi no tiene cuentas, servidores, anuncios, analíticas ni rastreo. Nada de lo que introduces se sube ni se comparte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Irovi não tem conta, servidores, anúncios, análises nem rastreamento. Nada do que você registra é enviado ou compartilhado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi n’a ni compte, ni serveurs, ni publicités, ni statistiques d’usage, ni suivi. Rien de ce que vous saisissez n’est envoyé ni partagé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi hat kein Konto, keine Server, keine Werbung, keine Analyse und kein Tracking. Nichts, was du einträgst, wird hochgeladen oder geteilt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi にはアカウント、サーバ、広告、分析、トラッキングは一切ありません。入力した内容がアップロードされたり共有されたりすることはありません。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi tidak memiliki akun, server, iklan, analitik, maupun pelacakan. Tidak ada yang Anda masukkan diunggah atau dibagikan."
          }
        }
      }
    },
    "Irovi is a wellness diary, not a medical device. It does not diagnose or recommend treatment. Talk to your doctor about your health.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi is a wellness diary, not a medical device. It does not diagnose or recommend treatment. Talk to your doctor about your health."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi là nhật ký sức khỏe, không phải thiết bị y tế. App không chẩn đoán hay gợi ý điều trị. Hãy trao đổi với bác sĩ về sức khỏe của bạn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi es un diario de bienestar, no un dispositivo médico. No diagnostica ni recomienda tratamientos. Habla con tu médico sobre tu salud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Irovi é um diário de bem-estar, não um dispositivo médico. Ele não faz diagnósticos nem recomenda tratamentos. Converse com seu médico sobre sua saúde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi est un journal de bien-être, pas un dispositif médical. L’app ne pose pas de diagnostic et ne recommande pas de traitement. Parlez de votre santé à votre médecin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi ist ein Wellness-Tagebuch, kein Medizinprodukt. Es stellt keine Diagnosen und empfiehlt keine Behandlung. Sprich mit deinem Arzt über deine Gesundheit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi はウェルネス日記であり、医療機器ではありません。診断や治療の推奨は行いません。健康については医師に相談してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi adalah buku harian kebugaran, bukan perangkat medis. Irovi tidak mendiagnosis atau merekomendasikan pengobatan. Bicarakan kesehatan Anda dengan dokter."
          }
        }
      }
    },
    "Irovi is a wellness diary. It is not a medical device and does not diagnose, treat or prevent any condition.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi is a wellness diary. It is not a medical device and does not diagnose, treat or prevent any condition."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi là nhật ký sức khỏe. App không phải thiết bị y tế và không chẩn đoán, điều trị hay phòng ngừa bệnh nào."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi es un diario de bienestar. No es un dispositivo médico y no diagnostica, trata ni previene ninguna enfermedad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Irovi é um diário de bem-estar. Ele não é um dispositivo médico e não diagnostica, trata nem previne nenhuma condição."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi est un journal de bien-être. Ce n’est pas un dispositif médical et l’app ne diagnostique, ne traite ni ne prévient aucune maladie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi ist ein Wellness-Tagebuch. Es ist kein Medizinprodukt und dient nicht der Diagnose, Behandlung oder Vorbeugung von Krankheiten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi はウェルネス日記です。医療機器ではなく、いかなる疾患の診断、治療、予防も行いません。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi adalah buku harian kebugaran. Irovi bukan perangkat medis dan tidak mendiagnosis, mengobati, atau mencegah kondisi apa pun."
          }
        }
      }
    },
