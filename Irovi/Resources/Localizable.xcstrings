    "Only enter a target your doctor gave you. Irovi doesn't suggest targets.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only enter a target your doctor gave you. Irovi doesn't suggest targets."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ nhập mục tiêu bác sĩ đưa cho bạn. Irovi không gợi ý mục tiêu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce solo un objetivo que te haya dado tu médico. Irovi no sugiere objetivos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só insira uma meta que seu médico passou. O Irovi não sugere metas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne saisissez qu’un objectif donné par votre médecin. Irovi ne suggère pas d’objectifs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib nur einen Zielwert ein, den dir dein Arzt genannt hat. Irovi schlägt keine Zielwerte vor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医師から示された目標値のみを入力してください。Irovi が目標値を提案することはありません。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan hanya target yang diberikan dokter Anda. Irovi tidak menyarankan target."
          }
        }
      }
    },
