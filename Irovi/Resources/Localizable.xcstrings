    "Short reads on iron and your blood, with sources.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short reads on iron and your blood, with sources."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài đọc ngắn về sắt và sức khỏe máu, có ghi nguồn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecturas breves sobre el hierro y tu sangre, con fuentes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leituras curtas sobre ferro e seu sangue, com fontes."
          }
        },
        "fr": {
