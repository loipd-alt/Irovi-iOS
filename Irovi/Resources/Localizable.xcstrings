    "The medicine is saved. Turn on notifications for Irovi in Settings to get reminders.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The medicine is saved. Turn on notifications for Irovi in Settings to get reminders."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu thuốc. Bật thông báo cho Irovi trong Cài đặt để nhận lời nhắc."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El medicamento se ha guardado. Activa las notificaciones de Irovi en Ajustes para recibir recordatorios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O remédio foi salvo. Ative as notificações do Irovi em Ajustes para receber lembretes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le médicament est enregistré. Activez les notifications d’Irovi dans Réglages pour recevoir des rappels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Medikament ist gespeichert. Aktiviere Mitteilungen für Irovi in den Einstellungen, um Erinnerungen zu erhalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "薬を保存しました。リマインダーを受け取るには、「設定」で Irovi の通知をオンにしてください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Obat telah disimpan. Aktifkan notifikasi untuk Irovi di Pengaturan untuk mendapat pengingat."
          }
        }
      }
    },
    "The next blood test reminder is on the Blood tab.": {
      "localizations": {
