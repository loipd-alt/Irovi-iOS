    "Reminders are local notifications created on your iPhone. You can export your data as a CSV file or delete it all in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders are local notifications created on your iPhone. You can export your data as a CSV file or delete it all in Settings."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời nhắc là thông báo được tạo ngay trên iPhone. Bạn có thể xuất dữ liệu thành file CSV hoặc xoá hết trong Cài đặt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios son notificaciones locales creadas en tu iPhone. Puedes exportar tus datos como archivo CSV o eliminarlos todos en Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes são notificações locais criadas no seu iPhone. Você pode exportar seus dados como arquivo CSV ou apagar tudo em Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels sont des notifications locales créées sur votre iPhone. Vous pouvez exporter vos données en fichier CSV ou tout supprimer dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen sind lokale Mitteilungen, die auf deinem iPhone erstellt werden. In den Einstellungen kannst du deine Daten als CSV-Datei exportieren oder alles löschen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーは iPhone 上で作成されるローカル通知です。データは「設定」で CSV ファイルとして書き出したり、すべて削除したりできます。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat adalah notifikasi lokal yang dibuat di iPhone Anda. Anda dapat mengekspor data sebagai file CSV atau menghapus semuanya di Pengaturan."
          }
        }
      }
    },
