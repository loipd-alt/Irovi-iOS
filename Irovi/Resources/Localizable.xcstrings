          }
        }
      }
    },
    "Six groups: red meat, seafood, poultry and eggs, beans, leafy greens, fortified grains.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Six groups: red meat, seafood, poultry and eggs, beans, leafy greens, fortified grains."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sáu nhóm: thịt đỏ, hải sản, gia cầm và trứng, đậu, rau lá xanh, ngũ cốc bổ sung sắt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seis grupos: carne roja, marisco, aves y huevos, legumbres, verduras de hoja verde, cereales enriquecidos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seis grupos: carne vermelha, frutos do mar, aves e ovos, feijões, folhas verdes, cereais fortificados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Six groupes : viande rouge, fruits de mer, volaille et œufs, légumineuses, légumes à feuilles, céréales enrichies."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sechs Gruppen: rotes Fleisch, Meeresfrüchte, Geflügel und Eier, Bohnen, Blattgemüse, angereichertes Getreide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "6つのグループ：赤身肉、魚介類、鶏肉と卵、豆類、葉物野菜、強化穀物。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Enam kelompok: daging merah, makanan laut, unggas dan telur, kacang, sayuran hijau, biji-bijian fortifikasi."
          }
        }
      }
    },
