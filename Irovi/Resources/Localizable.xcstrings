    "Tick the iron-rich food groups you eat each day and keep a streak going.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tick the iron-rich food groups you eat each day and keep a streak going."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh dấu nhóm thực phẩm giàu sắt bạn ăn mỗi ngày và giữ chuỗi ngày liên tiếp."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca los grupos de alimentos ricos en hierro que comes cada día y mantén tu racha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque os grupos de alimentos ricos em ferro que você come a cada dia e mantenha sua sequência."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez chaque jour les groupes d’aliments riches en fer que vous mangez et enchaînez les jours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hak die eisenreichen Lebensmittelgruppen ab, die du jeden Tag isst, und halte deine Serie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日食べた鉄分の多い食品グループにチェックして、連続記録を続けましょう。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Centang kelompok makanan kaya zat besi yang Anda makan setiap hari dan pertahankan rentetan Anda."
