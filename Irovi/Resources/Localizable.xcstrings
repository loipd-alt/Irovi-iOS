    "Optional reminders for meals, your medicines and your next test. Everything stays on your iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional reminders for meals, your medicines and your next test. Everything stays on your iPhone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhắc tuỳ chọn cho bữa ăn, thuốc và lần xét nghiệm tới. Mọi dữ liệu nằm trên iPhone của bạn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorios opcionales para comidas, tus medicamentos y tu próximo análisis. Todo se queda en tu iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes opcionais para refeições, seus remédios e seu próximo exame. Tudo fica no seu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappels facultatifs pour les repas, vos médicaments et votre prochaine analyse. Tout reste sur votre iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale Erinnerungen an Mahlzeiten, deine Medikamente und deinen nächsten Test. Alles bleibt auf deinem iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
