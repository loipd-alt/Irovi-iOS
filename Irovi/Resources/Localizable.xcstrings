    "Add a medicine to get a reminder and tick it off each day.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a medicine to get a reminder and tick it off each day."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm thuốc để được nhắc và đánh dấu đã uống mỗi ngày."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un medicamento para recibir un recordatorio y marcarlo cada día."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um remédio para receber um lembrete e marcá-lo todos os dias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un médicament pour recevoir un rappel et le cocher chaque jour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein Medikament hinzu, um erinnert zu werden und es jeden Tag abzuhaken."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "薬を追加すると、リマインダーを受け取って毎日チェックできます。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan obat untuk mendapat pengingat dan mencentangnya setiap hari."
          }
        }
      }
    },
