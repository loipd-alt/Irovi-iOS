    "Add hemoglobin and ferritin from your lab report and see how they change over time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add hemoglobin and ferritin from your lab report and see how they change over time."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập hemoglobin và ferritin trong phiếu xét nghiệm, xem chúng thay đổi theo thời gian."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade la hemoglobina y la ferritina de tu análisis y mira cómo cambian con el tiempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione a hemoglobina e a ferritina do seu laudo e veja como elas mudam ao longo do tempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez l’hémoglobine et la ferritine de votre compte rendu d’analyses et suivez leur évolution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag Hämoglobin und Ferritin aus deinem Laborbefund ein und sieh, wie sie sich mit der Zeit verändern."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検査結果のヘモグロビンとフェリチンを追加して、経過を確認しましょう。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan hemoglobin dan feritin dari hasil lab Anda dan lihat perubahannya dari waktu ke waktu."
          }
        }
      }
    },
    "Add only medicines a doctor or pharmacist told you to take. Irovi reminds you at the times you choose; it doesn't suggest medicines or doses.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add only medicines a doctor or pharmacist told you to take. Irovi reminds you at the times you choose; it doesn't suggest medicines or doses."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ thêm thuốc bác sĩ hoặc dược sĩ đã dặn bạn dùng. Irovi nhắc bạn vào giờ bạn chọn; app không gợi ý thuốc hay liều dùng."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade solo medicamentos que te haya indicado un médico o farmacéutico. Irovi te avisa a las horas que elijas; no sugiere medicamentos ni dosis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione só remédios que um médico ou farmacêutico indicou para você. O Irovi lembra você nos horários que você escolher; ele não sugere remédios nem doses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’ajoutez que les médicaments qu’un médecin ou un pharmacien vous a demandé de prendre. Irovi vous les rappelle aux heures que vous choisissez ; l’app ne suggère ni médicaments ni doses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge nur Medikamente hinzu, die du laut Arzt oder Apotheker nehmen sollst. Irovi erinnert dich zu den Zeiten, die du wählst; es schlägt keine Medikamente oder Dosierungen vor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医師または薬剤師から服用するよう指示された薬のみを追加してください。Irovi は選んだ時刻にお知らせするだけで、薬や用量を提案することはありません。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan hanya obat yang disarankan dokter atau apoteker untuk Anda minum. Irovi mengingatkan Anda pada waktu yang Anda pilih; Irovi tidak menyarankan obat atau dosis."
          }
        }
      }
    },
    "Add the hemoglobin and ferritin numbers from your lab report to see how they change over time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the hemoglobin and ferritin numbers from your lab report to see how they change over time."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập chỉ số hemoglobin và ferritin trong phiếu xét nghiệm để xem chúng thay đổi theo thời gian."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade los valores de hemoglobina y ferritina de tu análisis para ver cómo cambian con el tiempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione os valores de hemoglobina e ferritina do seu laudo para ver como eles mudam ao longo do tempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez les valeurs d’hémoglobine et de ferritine de votre compte rendu d’analyses pour suivre leur évolution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag die Hämoglobin- und Ferritinwerte aus deinem Laborbefund ein, um zu sehen, wie sie sich mit der Zeit verändern."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検査結果のヘモグロビンとフェリチンの数値を追加すると、経過を確認できます。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan angka hemoglobin dan feritin dari hasil lab Anda untuk melihat perubahannya dari waktu ke waktu."
          }
        }
      }
    },
    "Add your hemoglobin and ferritin to see them here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your hemoglobin and ferritin to see them here."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm hemoglobin và ferritin để xem ở đây."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tu hemoglobina y ferritina para verlas aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione sua hemoglobina e ferritina para vê-las aqui."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre hémoglobine et votre ferritine pour les voir ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Hämoglobin und Ferritin hinzu, um sie hier zu sehen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘモグロビンとフェリチンを追加すると、ここに表示されます。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan hemoglobin dan feritin Anda untuk melihatnya di sini."
          }
        }
      }
    },
