    "Nutrition information in Irovi is general and comes from public sources such as the US National Institutes of Health and the World Health Organization.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutrition information in Irovi is general and comes from public sources such as the US National Institutes of Health and the World Health Organization."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin dinh dưỡng trong Irovi là thông tin chung, lấy từ nguồn công khai như Viện Y tế Quốc gia Hoa Kỳ và Tổ chức Y tế Thế giới."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La información nutricional de Irovi es general y procede de fuentes públicas como los Institutos Nacionales de Salud de EE. UU. y la Organización Mundial de la Salud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As informações nutricionais do Irovi são gerais e vêm de fontes públicas, como os Institutos Nacionais de Saúde dos EUA e a Organização Mundial da Saúde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations nutritionnelles d’Irovi sont générales et proviennent de sources publiques comme les National Institutes of Health américains et l’Organisation mondiale de la santé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ernährungsinformationen in Irovi sind allgemein und stammen aus öffentlichen Quellen wie den US National Institutes of Health und der Weltgesundheitsorganisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi の栄養情報は一般的なもので、米国国立衛生研究所（NIH）や世界保健機関（WHO）などの公的な情報源に基づいています。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Informasi gizi di Irovi bersifat umum dan berasal dari sumber publik seperti National Institutes of Health (AS) dan Organisasi Kesehatan Dunia (WHO)."
          }
        }
      }
    },
