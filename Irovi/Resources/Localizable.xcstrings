    "Always talk to a doctor or pharmacist about your blood test results, symptoms and any treatment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always talk to a doctor or pharmacist about your blood test results, symptoms and any treatment."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy luôn trao đổi với bác sĩ hoặc dược sĩ về kết quả xét nghiệm, triệu chứng và mọi việc điều trị."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla siempre con un médico o farmacéutico sobre los resultados de tus análisis, tus síntomas y cualquier tratamiento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre converse com um médico ou farmacêutico sobre seus resultados de exame de sangue, sintomas e qualquer tratamento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez toujours à un médecin ou à un pharmacien de vos résultats d’analyses, de vos symptômes et de tout traitement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich über deine Blutwerte, Symptome und jede Behandlung immer mit einem Arzt oder Apotheker."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "血液検査の結果、症状、治療については、必ず医師または薬剤師に相談してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selalu bicarakan hasil tes darah, gejala, dan pengobatan apa pun dengan dokter atau apoteker."
          }
        }
      }
    },
