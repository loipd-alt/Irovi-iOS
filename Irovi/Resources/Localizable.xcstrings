    },
    "Copy the numbers from your lab report. Leave a field empty if it wasn't tested.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chép các con số trong phiếu xét nghiệm. Để trống ô nào không được xét nghiệm."
          }
        }
      }
    },
    "Daily food reminder": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhắc ăn mỗi ngày"
