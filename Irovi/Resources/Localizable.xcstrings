    "Everything stays on this iPhone. There is no account and nothing is uploaded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on this iPhone. There is no account and nothing is uploaded."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi dữ liệu nằm trên iPhone này. Không có tài khoản và không tải lên đâu cả."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se queda en este iPhone. No hay cuenta y no se sube nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica neste iPhone. Não há conta e nada é enviado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur cet iPhone. Aucun compte, rien n’est envoyé en ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf diesem iPhone. Es gibt kein Konto und nichts wird hochgeladen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデータはこの iPhone に保存されます。アカウントは不要で、何もアップロードされません。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua tetap di iPhone ini. Tidak ada akun dan tidak ada yang diunggah."
          }
        }
      }
    },
    "Everything you enter in Irovi (your checklist, blood test results and medicines) is stored only on this iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you enter in Irovi (your checklist, blood test results and medicines) is stored only on this iPhone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ bạn nhập trong Irovi (checklist, kết quả xét nghiệm và thuốc) chỉ được lưu trên iPhone này."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que introduces en Irovi (tu lista, los resultados de tus análisis y tus medicamentos) se guarda solo en este iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que você registra no Irovi (sua lista, resultados de exames de sangue e remédios) fica armazenado apenas neste iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous saisissez dans Irovi (votre liste, vos résultats d’analyses et vos médicaments) est stocké uniquement sur cet iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du in Irovi einträgst (deine Checkliste, Blutwerte und Medikamente), wird nur auf diesem iPhone gespeichert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Irovi に入力した内容（チェックリスト、血液検査の結果、薬）は、すべてこの iPhone にのみ保存されます。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang Anda masukkan di Irovi (daftar centang, hasil tes darah, dan obat) hanya disimpan di iPhone ini."
          }
        }
      }
    },
